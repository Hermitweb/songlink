<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ 的数据提取/备份规则 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>