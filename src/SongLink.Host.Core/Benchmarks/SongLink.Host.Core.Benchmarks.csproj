<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <OutputType>Exe</OutputType>
    <AssemblyName>SongLink.Host.Benchmarks</AssemblyName>
    <RootNamespace>SongLink.Host.Benchmarks</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- 本工程嵌套在 SongLink.Host.Core 目录内，故引用路径是 ../ 而不是 ../SongLink.Host.Core/。
         原写法 ..\SongLink.Host.Core\SongLink.Host.Core.csproj 解析到
         src\SongLink.Host.Core\SongLink.Host.Core\SongLink.Host.Core.csproj（不存在），
         MSBuild 会报 MSB9008 静默跳过 —— 这条引用从来没有真正生效过。 -->
    <ProjectReference Include="..\SongLink.Host.Core.csproj" />
  </ItemGroup>

</Project>