<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>SongLink.Host.Adapters.Smtc</AssemblyName>
    <RootNamespace>SongLink.Host.Adapters.Smtc</RootNamespace>
    <NoWarn>$(NoWarn);CA1416;CS8602</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SongLink.Protocol\SongLink.Protocol.csproj" />
    <ProjectReference Include="..\SongLink.Host.Core\SongLink.Host.Core.csproj" />
  </ItemGroup>

  <!--
    目标框架 net8.0-windows10.0.19041.0 会让 .NET SDK 自动把
    Microsoft.Windows.SDK.NET.Ref(WinRT 投影)作为 targeting pack 从 NuGet 拉下来
    —— 不需要装 VS「Windows 应用开发」工作负载,也不需要独立 Windows SDK。
    参见 obj/project.assets.json 的 downloadDependencies。

    曾经本工程长期编译不过,原因是 SmtcAdapter.cs 照着不存在的 API 写的
    (CurrentChanged / MediaProperties / PlaybackInfo 属性 / TrySkipNextAheadAsync /
    ThumbnailProperties),不是环境缺 pack。已于 d2b9f5a 之后按真实 WinRT API 重写。
  -->

</Project>
