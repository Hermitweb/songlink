  "displayName": "酷狗音乐",
  "exeNames": ["KuGou"],
  "windowTitleRegex": "酷狗音乐",
  "windowClassName": "kugou_ui",
  "mediaSessionAppId": "kugou",
  "blockWhenScreenFilling": true,
  "launchPath": null,

  "searchBoxAutomationId": null,
  "searchBoxName": null,
