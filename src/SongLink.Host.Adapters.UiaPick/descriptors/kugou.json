{
  // 酷狗音乐 Windows 桌面客户端 —— 坐标标定（2026-10-26 本机实测，20.1.32.27840 深色主题）
  //
  // 实测结论（这台机器，KuGou.exe 20.1.32.27840）：
  //   · 客户端是 CEF（libcef.dll），远程调试被编译版禁用 → 没有 CDP
  //   · 社区那套 workbuddy 控制桥（kugou://workbuddy?p=端口）本机**不支持**：
  //     对整个安装目录做字节级搜索，"workbuddy" 零命中；需要客户端 ≥ 20.1.40
  //   · `kugou://` 已注册为 KuGou.exe "%1"，但可用格式未确证 → 不猜
  //   · 客户端**会**注册系统媒体会话（AppId = "kugou"），所以传输控制与"真在播"校验都能用
  //   · 窗口类 kugou_ui，但**歌手模式**下它是全屏歌词页（没有搜索框），
  //     必须先让用户切回主界面才能点歌
  //
  // 标定过程（2026-10-26，见 .tmp/kg_*.png 与 ocrprobe）：
  //   搜索框在**标题栏**：矩形约 (316,26)-(583,52)，放大镜图标在框左缘，右侧紧贴红色"搜索"按钮。
  //   实测点击 (420,39)（框内偏左）→ 粘贴"晴天 周杰伦" → 回车，进入搜索结果页。
  //   结果页"单曲"第一行标题 ≈ (335..390, 372..385)，第二行标题 ≈ (335..390, 436..449)，
  //   行距 64px。标题文字起点 x≈334（左侧是封面图）。
  //
  // 这里存的是**窗口内归一化坐标**（基于 GetWindowRect 外框），换分辨率/窗口大小都还对得上；
  // 点歌前 CoordinateMusicPicker 会把窗口调回下面的标定尺寸。
  "appId": "kugou",
  "displayName": "酷狗音乐",
  "exeNames": ["KuGou"],
  "windowTitleRegex": "酷狗音乐",
  "windowClassName": "kugou_ui",
  "mediaSessionAppId": "kugou",
  "blockWhenScreenFilling": true,
  "launchPath": null,

  "searchBoxAutomationId": null,
  "searchBoxName": null,
  "submitKey": "Enter",
  "resultItemAutomationId": null,
  "resultItemNameRegex": null,
  "doubleClickResult": true,
  "pickTimeoutMs": 2500,

  // 坐标驱动点歌（窗口内归一化 0..1，标定基准窗口 1324x816）
  //   搜索框输入区中心 ≈ (449, 39)   → (0.3391, 0.0478)
  //   结果第一行标题   ≈ (355, 379)  → (0.2681, 0.4645)
  //   行距 64px                    → 0.0784
  "searchBoxRatio": [0.3391, 0.0478],
  "resultItemRatio": [0.2681, 0.4645],
  "resultRowHeightRatio": 0.0784,
  "calibrationWidth": 1324,
  "calibrationHeight": 816,
  "maxResultRows": 8,

  // 旧版 OCR 兜底坐标（屏幕绝对，仅在 OCR 引擎接上后才有意义）
  "searchBoxPoint": [470, 61],
  "resultRegion": [300, 120, 700, 480],
  "ocrLanguageTag": "zh-Hans"
}
