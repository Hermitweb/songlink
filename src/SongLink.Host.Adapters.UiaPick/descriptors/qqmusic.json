{
  // QQ音乐 Windows 桌面客户端 —— 坐标标定（2026-10-19 真机）
  //
  // 实测结论（这台机器，QQMusic.exe）：
  //   · 客户端界面是 CEF/TX 自绘，UIA 读不到搜索框 → 只能走坐标
  //   · 没有 CDP（--remote-debugging-port 不生效）
  //   · 命令行 7 种形式（/playbysongid、裸 mid、songDetail 链接…）实测全部无效
  //   · 客户端**会**注册系统媒体会话（AppId = "QQMusic.exe"），所以点完可以用它校验"真在播"
  //   · 非会员点 VIP 歌会弹付费窗（点歌会失败，必须如实提示）
  //
  // 标定基准窗口：1226x800，搜索框在 (480,38)，搜索结果第一行标题在 (295,366)。
  // 这里存的是**窗口内归一化坐标**，换分辨率/窗口大小都还对得上。
  "appId": "qqmusic",
  "displayName": "QQ 音乐",
  "exeNames": ["QQMusic"],
  "windowTitleRegex": "QQ音乐",
  "windowClassName": "TXGuiFoundation",
  "mediaSessionAppId": "QQMusic.exe",
  "launchPath": null,

  // UIA 定位：CEF 自绘，用不上（保留空）
  "searchBoxAutomationId": null,
  "searchBoxName": null,
  "submitKey": "Enter",
  "resultItemAutomationId": null,
  "resultItemNameRegex": null,
  "doubleClickResult": true,
  "pickTimeoutMs": 2500,

  // 坐标驱动点歌（窗口内归一化 0..1）
  // 标定基准窗口：1226x800（点歌前会把客户端窗口调回这个尺寸，标定才恒定成立）
  //   搜索框输入区中心 ≈ (480, 38)  → (0.3915, 0.0475)
  //   结果第一行标题 ≈ (295, 366)    → (0.2406, 0.4575)
  //   结果行间距 ≈ 54px              → 0.0675（逐行试点时用）
  "searchBoxRatio": [0.3915, 0.0475],
  "resultItemRatio": [0.2406, 0.4575],
  "resultRowHeightRatio": 0.0675,
  "calibrationWidth": 1226,
  "calibrationHeight": 800,
  "maxResultRows": 8,

  // 旧版 OCR 兜底坐标（屏幕绝对，仅在 OCR 引擎接上后才有意义）
  "searchBoxPoint": [470, 61],
  "resultRegion": [300, 120, 700, 480],
  "ocrLanguageTag": "zh-Hans"
}
